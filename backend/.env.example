# App Configurations
APP_NAME=Capturo
DEBUG=True
PORT=8000

# Database Configurations
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/capturo

# Security
SECRET_KEY=supersecretkeyplaceholder
