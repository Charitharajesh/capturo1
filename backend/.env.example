# --- SMTP / EMAIL ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=app.services.v1@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=app.services.v1@gmail.com
