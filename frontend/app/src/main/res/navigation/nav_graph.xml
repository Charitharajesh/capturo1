<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <!-- Attendee Destinations -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.capturo.app.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/activeBookingsFragment"
        android:name="com.capturo.app.ui.booking.ActiveBookingsFragment"
        android:label="Bookings" />

    <fragment
        android:id="@+id/chatFragment"
        android:name="com.capturo.app.ui.chat.ChatFragment"
        android:label="Messages" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.capturo.app.ui.profile.ProfileFragment"
        android:label="Profile" />

    <!-- Creator Destinations -->
    <fragment
        android:id="@+id/creatorDashboardFragment"
        android:name="com.capturo.app.ui.creatorDashboard.CreatorDashboardFragment"
        android:label="Dashboard" />

    <fragment
        android:id="@+id/bookingRequestsFragment"
        android:name="com.capturo.app.ui.creatorDashboard.BookingRequestsFragment"
        android:label="Requests" />

    <fragment
        android:id="@+id/creatorGalleryFragment"
        android:name="com.capturo.app.ui.creatorDashboard.CreatorGalleryFragment"
        android:label="Gallery" />

    <fragment
        android:id="@+id/bookingDetailFragment"
        android:name="com.capturo.app.ui.booking.BookingDetailFragment"
        android:label="Booking Details">
        <argument
            android:name="booking_id"
            app:argType="string" />
        <action
            android:id="@+id/action_bookingDetailFragment_to_deliveryFragment"
            app:destination="@id/deliveryFragment" />
    </fragment>

    <fragment
        android:id="@+id/creatorProfileFragment"
        android:name="com.capturo.app.ui.creator.CreatorProfileFragment"
        android:label="Creator Profile">
        <argument
            android:name="creator_id"
            app:argType="string" />
        <argument
            android:name="hide_ctas"
            app:argType="boolean"
            android:defaultValue="false" />
        <action
            android:id="@+id/action_creatorProfileFragment_to_createBookingFragment"
            app:destination="@id/createBookingFragment" />
    </fragment>

    <fragment
        android:id="@+id/nearbyCreatorsFragment"
        android:name="com.capturo.app.ui.search.NearbyCreatorsFragment"
        android:label="Nearby Creators"
        tools:layout="@layout/fragment_nearby_creators" />

    <fragment
        android:id="@+id/mapViewFragment"
        android:name="com.capturo.app.ui.search.MapViewFragment"
        android:label="Map View"
        tools:layout="@layout/fragment_map_view" />

    <fragment
        android:id="@+id/notificationsFragment"
        android:name="com.capturo.app.ui.notifications.NotificationsFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notifications" />

    <fragment
        android:id="@+id/deliveryFragment"
        android:name="com.capturo.app.ui.gallery.GalleryFragment"
        android:label="Delivered Media"
        tools:layout="@layout/fragment_gallery">
        <argument
            android:name="booking_id"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.capturo.app.ui.payment.PaymentFragment"
        android:label="Payment"
        tools:layout="@layout/fragment_payment">
        <argument
            android:name="booking_id"
            app:argType="string" />
        <argument
            android:name="order_id"
            app:argType="string" />
        <argument
            android:name="key_id"
            app:argType="string" />
        <argument
            android:name="amount"
            app:argType="float" />
        <argument
            android:name="creator_name"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/createBookingFragment"
        android:name="com.capturo.app.ui.booking.CreateBookingFragment"
        android:label="Create Booking"
        tools:layout="@layout/fragment_create_booking">
        <argument
            android:name="creator_id"
            app:argType="string" />
        <argument
            android:name="hourly_rate"
            app:argType="float" />
        <argument
            android:name="creator_name"
            app:argType="string" />
        <argument
            android:name="creator_avatar_url"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.capturo.app.ui.profile.EditProfileFragment"
        android:label="Edit Profile"
        tools:layout="@layout/fragment_edit_profile" />

    <fragment
        android:id="@+id/payoutsFragment"
        android:name="com.capturo.app.ui.profile.PayoutsFragment"
        android:label="Payouts"
        tools:layout="@layout/fragment_payouts" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.capturo.app.ui.profile.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

</navigation>
