<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base deep violet -->
    <item>
        <shape>
            <solid android:color="#0D0020"/>
        </shape>
    </item>
    <!-- Subtle top-center radial glow -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.0"
                android:gradientRadius="60%p"
                android:startColor="#3D147315"
                android:endColor="#00000000"/>
        </shape>
    </item>
</layer-list>
