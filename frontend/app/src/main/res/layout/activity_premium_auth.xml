<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_bottom" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="bottom"
            android:paddingHorizontal="24dp"
            android:paddingTop="300dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Welcome to Capturo"
                android:textColor="@color/white"
                android:textSize="30sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="32dp"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/brand_subtitle"
                android:textColor="@color/colorTextSecondary"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/btnGoogle"
                style="@style/PremiumSocialButton">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_google" />

                <TextView
                    style="@style/PremiumSocialText"
                    android:text="Continue with Google" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnPhone"
                style="@style/PremiumSocialButton">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_call"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    style="@style/PremiumSocialText"
                    android:text="Continue with Phone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnEmail"
                style="@style/PremiumSocialButton">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_email"
                    app:tint="@color/colorTextPrimary" />

                <TextView
                    style="@style/PremiumSocialText"
                    android:text="Continue with Email" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnPrimaryEnter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_gold_button"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Find Your Photographer"
                android:textColor="@color/colorTextOnAccent"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Capture Moments. Book Memories."
                android:textColor="@color/colorTextHint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
