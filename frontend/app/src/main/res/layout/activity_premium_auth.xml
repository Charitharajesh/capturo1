<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_image_placeholder"
        android:contentDescription="hero" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_scrim_bottom" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="210dp"
            android:paddingBottom="36dp">

            <TextView
                android:id="@+id/textTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Create your account"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/textSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="18dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Sign up to book and cherish your moments"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/inputName"
                style="@style/PremiumInputField"
                android:layout_marginHorizontal="0dp"
                android:hint="Full name"
                android:inputType="textPersonName" />

            <EditText
                android:id="@+id/inputEmail"
                style="@style/PremiumInputField"
                android:layout_marginHorizontal="0dp"
                android:hint="Email address"
                android:inputType="textEmailAddress" />

            <EditText
                android:id="@+id/inputPassword"
                style="@style/PremiumInputField"
                android:layout_marginHorizontal="0dp"
                android:hint="Password"
                android:inputType="textPassword" />

            <EditText
                android:id="@+id/inputConfirm"
                style="@style/PremiumInputField"
                android:layout_marginHorizontal="0dp"
                android:hint="Re-enter password"
                android:inputType="textPassword" />

            <TextView
                android:id="@+id/btnPrimaryEnter"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_gold_button"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="Create Account"
                android:textColor="@color/colorTextOnAccent"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnToggleMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:padding="6dp"
                android:text="Already have an account? Log in"
                android:textColor="@color/colorTextSecondary"
                android:textSize="13sp" />

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/colorTextHint"
                    android:alpha="0.35" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="or"
                    android:textColor="@color/colorTextHint"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/colorTextHint"
                    android:alpha="0.35" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnGoogle"
                style="@style/PremiumSocialButton"
                android:layout_marginBottom="0dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_google" />

                <TextView
                    style="@style/PremiumSocialText"
                    android:text="Continue with Google" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Capture Moments. Book Memories."
                android:textColor="@color/colorTextHint"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
