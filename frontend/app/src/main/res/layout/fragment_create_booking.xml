<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_grid_pattern"
    tools:context=".ui.booking.CreateBookingFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/statusBarColor"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:title="Create Booking"
            app:titleTextColor="@color/colorTextPrimary" />

        <!-- Horizontal Step Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:paddingBottom="16dp"
            android:background="@color/statusBarColor">

            <!-- Step 1 Circle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/indicatorStep1"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_indicator_active"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold" />
                <TextView
                    android:id="@+id/textLabelStep1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Category"
                    android:textColor="@color/colorAccent"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_semibold" />
            </LinearLayout>

            <!-- Connector 1 -->
            <View
                android:id="@+id/connector1"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginBottom="14dp"
                android:background="@color/colorBorder" />

            <!-- Step 2 Circle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/indicatorStep2"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_indicator_inactive"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold" />
                <TextView
                    android:id="@+id/textLabelStep2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Schedule"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>

            <!-- Connector 2 -->
            <View
                android:id="@+id/connector2"
                android:layout_width="0dp"
                android:layout_height="2dp"
                android:layout_weight="1"
                android:layout_marginBottom="14dp"
                android:background="@color/colorBorder" />

            <!-- Step 3 Circle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/indicatorStep3"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_indicator_inactive"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_bold" />
                <TextView
                    android:id="@+id/textLabelStep3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Details"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="10sp"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="120dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Pre-populated Creator Mini Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/colorSurface"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/colorBorder"
                app:strokeWidth="1dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/textCreatorLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Booking with"
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/textCreatorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/textCreatorLabel"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="Alex Rivera"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/textHourlyRate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/poppins_bold"
                        android:text="₹1,999/hr"
                        android:textColor="@color/colorAccent"
                        android:textSize="16sp" />
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- STEP 1: CATEGORY & DURATION -->
            <LinearLayout
                android:id="@+id/layoutStep1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Dynamic Event Type Header & Illustration Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardBackgroundColor="@color/colorSurfaceElevated"
                    app:strokeWidth="0dp">
                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">
                        
                        <ImageView
                            android:id="@+id/imageEventCategory"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/bg_cover_scrim"
                            android:alpha="0.4" />
                            
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentBottom="true"
                            android:layout_margin="16dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="Select Event Type &amp; Duration"
                            android:textColor="@color/white"
                            android:textSize="18sp"/>
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Event Type Spinner -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEventType"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundColor="@color/colorSurface"
                    app:boxStrokeColor="@color/colorBorder"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/colorTextSecondary">

                    <AutoCompleteTextView
                        android:id="@+id/spinnerEventType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="16dp"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Event Type"
                        android:inputType="none"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint"
                        tools:ignore="LabelFor" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Duration Selector -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Booking Duration"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonMinus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/colorSurface"
                        android:text="-"
                        android:textColor="@color/colorTextPrimary"
                        app:cornerRadius="999dp" />

                    <TextView
                        android:id="@+id/textDurationValue"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:text="2.0 Hours"
                        android:textColor="@color/colorTextPrimary"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonPlus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:backgroundTint="@color/colorSurface"
                        android:text="+"
                        android:textColor="@color/colorTextPrimary"
                        app:cornerRadius="999dp" />
                </LinearLayout>

                <!-- Step 1 Cost Estimate Info -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorBorder"
                    app:strokeWidth="1dp">
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Current Cost Rate"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp"
                            android:id="@+id/lblCost" />
                        <TextView
                            android:id="@+id/textCalculationDetailsStep1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/lblCost"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="₹1,999/hr × 2.0 hrs"
                            android:textColor="@color/white"
                            android:textSize="14sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- STEP 2: DATE & TIME SCHEDULING -->
            <LinearLayout
                android:id="@+id/layoutStep2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Select Event Date &amp; Time"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <!-- 3-Day Restriction Alert / Warning Notice Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:cardBackgroundColor="#22002A"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FFB300"
                    app:strokeWidth="1dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📅"
                            android:textSize="20sp" />
                            
                        <TextView
                            android:id="@+id/textSchedulingWarning"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Scheduling Limit: Bookings must be scheduled at least 3 days in advance of the event date. Choose a date carefully."
                            android:textColor="#FFCA28"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Event Date -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutEventDate"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundColor="@color/colorSurface"
                    app:boxStrokeColor="@color/colorBorder"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/colorTextSecondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editEventDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Event Date"
                        android:inputType="none"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Start Time -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutStartTime"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:boxBackgroundColor="@color/colorSurface"
                    app:boxStrokeColor="@color/colorBorder"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/colorTextSecondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editStartTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Start Time"
                        android:inputType="none"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- STEP 3: LOCATION & REVIEW -->
            <LinearLayout
                android:id="@+id/layoutStep3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Venue &amp; Location Details"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:layout_marginBottom="16dp"/>

                <!-- Event Location TextInputLayout -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutLocation"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:boxBackgroundColor="@color/colorSurface"
                    app:boxStrokeColor="@color/colorBorder"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/colorTextSecondary"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_location_pin"
                    app:endIconContentDescription="Auto Detect Location"
                    app:endIconTint="@color/colorAccent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="16dp"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="Venue / Location"
                        android:inputType="textPostalAddress"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Autodetect GPS Loader indicator -->
                <LinearLayout
                    android:id="@+id/layoutLocationDetecting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">
                    <ProgressBar
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:indeterminateTint="@color/colorAccent" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Detecting live GPS location..."
                        android:textColor="@color/colorTextSecondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Location Address Suggestions List Container -->
                <LinearLayout
                    android:id="@+id/layoutSuggestionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/colorSurfaceElevated"
                    android:layout_marginBottom="16dp"
                    android:padding="8dp"
                    android:visibility="gone">
                    <!-- Suggestions will be populated dynamically -->
                </LinearLayout>

                <!-- Special Notes -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutSpecialNotes"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    app:boxBackgroundColor="@color/colorSurface"
                    app:boxStrokeColor="@color/colorBorder"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/colorTextSecondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editSpecialNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="16dp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="top"
                        android:hint="Special Notes / Requirements"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:textColor="@color/colorTextPrimary"
                        android:textColorHint="@color/colorTextHint" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Summary & Cost display Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/colorSurfaceVariant"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorBorderActive"
                    app:strokeWidth="1.5dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/textCostLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:text="Estimated Total Cost"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textTotalAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/textCostLabel"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="₹3,998"
                            android:textColor="@color/colorAccent"
                            android:textSize="22sp" />

                        <TextView
                            android:id="@+id/textCalculationDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:fontFamily="@font/poppins_regular"
                            android:text="₹1,999/hr × 2.0 hrs"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="12sp" />
                    </RelativeLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Sticky Navigation Row (Back/Next & Confirm) -->
    <LinearLayout
        android:id="@+id/layoutBottomCta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:elevation="24dp"
        android:background="@drawable/bg_onboarding"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonPrevStep"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginEnd="12dp"
            android:text="BACK"
            android:textColor="@color/colorTextSecondary"
            android:fontFamily="@font/poppins_semibold"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonConfirm"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:backgroundTint="@color/colorAccent"
            android:fontFamily="@font/poppins_semibold"
            android:text="NEXT STEP"
            android:textColor="@color/white"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
