<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="28dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:id="@+id/iconCheck"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/ic_check_circle"
        app:tint="@color/colorSuccess" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Booking Confirmed! 🎉"
        android:textColor="@color/colorTextPrimary"
        android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Your photographer has been booked successfully."
        android:textColor="@color/colorTextSecondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_card_premium"
        android:orientation="vertical"
        android:padding="20dp">

        <include android:id="@+id/rowBookingId" layout="@layout/item_premium_summary_row" />

        <include android:id="@+id/rowPhotographer" layout="@layout/item_premium_summary_row" />

        <include android:id="@+id/rowDate" layout="@layout/item_premium_summary_row" />

        <include android:id="@+id/rowTime" layout="@layout/item_premium_summary_row" />

        <include android:id="@+id/rowLocation" layout="@layout/item_premium_summary_row" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btnViewBooking"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_gold_button"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="View Booking"
        android:textColor="@color/colorTextOnAccent"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/btnHome"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_gold_outline"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="Back to Home"
        android:textColor="@color/colorPrimary"
        android:textSize="16sp" />
</LinearLayout>
